### 测试 User -- 登录
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    request.variables.set("clients", [
        {
            case: 'admin 登陆',
            req: {
                nameEn: 'admin',
                password: 'admin'
            },
            rsp: {
                code: -200002
            }
        },
        {
            case: '田七登陆',
            req: {
                nameEn: 'tianqi',
                password: '123456'
            },
            rsp: {
                code: -200002
            }
        },
        {
            case: '赵六登陆',
            req: {
                nameEn: 'zhaoliu',
                password: '123456'
            },
            rsp: {
                code: -200002
            }
        },
        {
            case: '王五登陆',
            req: {
                nameEn: 'wangwu',
                password: '123456'
            },
            rsp: {
                code: -200002
            }
        },
        {
            case: '李四登陆',
            req: {
                nameEn: 'lisisi',
                password: '123456'
            },
            rsp: {
                code: -200002
            }
        },
        {
            case: '张三登陆',
            req: {
                nameEn: 'zhangsan',
                password: '123456'
            },
            rsp: {
                code: -200002
            }
        }
    ])
%}
POST https://127.0.0.1/backend/web/user/login?language={{language}}
Date: {{date}}
Content-Type: application/json

{
  "nameEn": "{{$.clients..req.nameEn}}",
  "password": "{{$.clients..req.password}}"
}

> {%
    import {checkAPIResult, parseAndSaveWebAuthorization} from './http_util.js'

    let current = request.variables.get("clients")[request.iteration()]
    const [name, session] = parseAndSaveWebAuthorization(response)
    client.test(`测试响应结果 -- 登录 -- ${current.case}`, () => {
        checkAPIResult(200, current.rsp.code)
        client.assert(name && session, 'name or session not found')
    })
    client.global.set(`csms_session_${name}`, session)
%}


### 测试 User -- 获取用户信息
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/user/getInformation?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const info = response.body.data
    client.test('测试响应结果 -- 获取用户信息', () => {
        checkAPIResult(200, undefined)
        client.assert(info, "info is empty")
    })
%}



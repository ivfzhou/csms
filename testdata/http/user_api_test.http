### 测试 User -- 搜索用户
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/user/search?language={{language}}&name=zhangsan
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const result = response.body.data.users
    client.test('测试响应结果 -- 搜索用户', () => {
        checkAPIResult(200, undefined)
        client.assert(result, 'result is empty')
    })
%}


### 测试 User -- 登出
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
DELETE https://127.0.0.1/backend/web/user/logout?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const exist = response.headers.valueOf('Set-Cookie')
    client.test('测试响应结果 -- 登出', () => {
        checkAPIResult(200, -200003)
        client.assert(exist, 'session is empty')
    })
%}


### 设置 zhangsan 会话
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/user/login?language={{language}}
Date: {{date}}
Content-Type: application/json

{
  "nameEn": "zhangsan",
  "password": "123456"
}

> {%
    import {checkAPIResult, parseAndSaveWebAuthorization} from './http_util.js'

    const [name, session] = parseAndSaveWebAuthorization(response)
    checkAPIResult(200, -200002)
    client.assert(name && session, 'name or session not found')
    client.global.set(`csms_session_zhangsan`, session)
%}

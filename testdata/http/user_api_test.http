import upload_avatar.http


### 测试 User -- 注册张三
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    request.variables.set("clients", [
        {
            case: '正常测试',
            req: {
                nameZh: '张三',
                nameEn: 'zhangsan',
                password: '123456',
                passwordConfirmation: '123456',
                department: '/技术部/后台'
            },
            rsp: {
                code: -200001
            }
        },
        {
            case: '英文名已被占用',
            req: {
                nameZh: '张三',
                nameEn: 'zhangsan',
                password: '123456',
                passwordConfirmation: '123456',
                department: '/技术部/后台'
            },
            rsp: {
                code: 200009
            }
        }
    ])
%}
POST https://127.0.0.1/backend/web/user/register?language={{language}}
Date: {{date}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="nameZh"
Content-Type: text/plain

{{$.clients..req.nameZh}}
--WebAppBoundary
Content-Disposition: form-data; name="nameEn"
Content-Type: text/plain

{{$.clients..req.nameEn}}
--WebAppBoundary
Content-Disposition: form-data; name="password"
Content-Type: text/plain

{{$.clients..req.password}}
--WebAppBoundary
Content-Disposition: form-data; name="passwordConfirmation"
Content-Type: text/plain

{{$.clients..req.passwordConfirmation}}
--WebAppBoundary
Content-Disposition: form-data; name="department"
Content-Type: text/plain

{{$.clients..req.department}}
--WebAppBoundary
Content-Disposition: form-data; name="avatar"; filename="zhangsan_avatar.jpg"
Content-Type: image/jpeg

< ../file/zhangsan_avatar.jpg
--WebAppBoundary--

> {%
    import {checkAPIResult} from './http_util.js'

    let current = request.variables.get("clients")[request.iteration()]
    client.test(`测试响应结果 -- ${current.case}`, () => {
        checkAPIResult(200, current.rsp.code)
    })
%}



### 测试 Event -- 获取应用事件列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/event/list?language={{language}}&pageNumber=1&pageSize=10&app=w&platform=1&source=1&
    type=1&user=zh&beginTime=2024-01-01 00:00:00&endTime=2029-01-01 00:00:00
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    client.test('测试响应结果 -- 获取应用事件列表', () => {
        checkAPIResult(200, undefined)
        client.assert(list, 'list is empty')
    })
%}


### 测试 Event -- 获取应用事件统计数量
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/event/statistic?language={{language}}&timeStep=3&beginTime=2024-01-01&
    appId={{windowsAppId}}&endTime=2029-01-01
Date: {{date}}
Cookie: csms_user=admin; csms_session={{csms_session_admin}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    client.test('测试响应结果 -- 获取应用事件统计数量', () => {
        checkAPIResult(200, undefined)
        client.assert(list, 'list is empty')
    })
%}

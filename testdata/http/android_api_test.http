### 测试 Android -- 获取安卓证书列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/android/listCertificates/{{androidAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    client.test('测试响应结果 -- 获取安卓证书列表', () => {
        checkAPIResult(200, undefined)
        client.assert(list, 'list is empty')
    })
    client.global.set('uploadAndroidCertificateId', list[0].id)
    client.global.set('releaseAndroidCertificateId', list[1].id)
    client.global.set('debugAndroidCertificateId', list[2].id)
%}



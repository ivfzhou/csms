### 测试 Android OpenAPI -- 获取任务信息
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('androidAppId')
    const apiAccountId = 'android_api_account';
    const secret = client.global.get(apiAccountId)
    client.log(appId, apiAccountId, secret)
    const token = createAuthorization(appId, apiAccountId, secret)
    request.variables.set('token', token)

    request.variables.set('clients', [
        {
            'jobId': client.global.get('apkPatchJobId')
        },
        {
            'jobId': client.global.get('apkJobId')
        },
        {
            'jobId': client.global.get('aabJobId')
        }
    ])
%}
GET https://127.0.0.1/backend/api/android/getSigningJobInformation?jobId={{$.clients..jobId}}
Authorization: Bearer {{token}}


> {%
    import {checkAPIResult} from './http_util.js'


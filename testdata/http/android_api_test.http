### 测试 Android -- 添加证书主体
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/android/addOrganization?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=admin; csms_session={{csms_session_admin}}

{
  "commonName": "company certificate",
  "dName": "C=CN,ST=Hunan,L=Changsha,CN=company_android_cert"
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 添加证书主体', () => {
        checkAPIResult(200, -200004)
    })
%}


### 测试 Android -- 获取安卓主体信息列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/android/listOrganizations?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=admin; csms_session={{csms_session_admin}}

> {%
    import {checkAPIResult} from './http_util.js'

    const id = response.body.data.list.pop().id
    client.test('测试响应结果 -- 获取安卓主体信息列表', () => {
        checkAPIResult(200, undefined)
        client.assert(id, `organization id is empty`)
    })
    client.global.set('androidOrganizationId', id)
%}



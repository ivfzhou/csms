### 测试 App -- 获取用户具有权限的应用个数
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/app/count?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const count = response.body.data.count
    client.test('测试响应结果 -- 获取用户具有权限的应用个数', () => {
        checkAPIResult(200, undefined)
        client.assert(count, "count does not meet expectation")
    })
%}



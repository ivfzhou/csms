### 测试 App -- 查询 - 设置 Windows 应用 ID
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/app/search?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}
Content-Type: application/json

{
  "platform": [
    1
  ],
  "status": [
    1
  ]
}

> {%
    import {checkAPIResult} from './http_util.js'

    const appId = response.body.data.list.pop().id
    checkAPIResult(200, undefined)
    client.assert(appId, 'windows app id not found')
    client.global.set('windowsAppId', appId)
%}



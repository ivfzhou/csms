import approve_app_register.http
import upload_logo.http
import approve_app_enable.http


### 测试 App -- 注册 Windows
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/app/register?language={{language}}
Date: {{date}}
Content-Type: multipart/form-data; boundary=WebAppBoundary
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

--WebAppBoundary
Content-Disposition: form-data; name="name"
Content-Type: text/plain

Windows应用
--WebAppBoundary
Content-Disposition: form-data; name="platform"
Content-Type: text/plain

1
--WebAppBoundary
Content-Disposition: form-data; name="admins"
Content-Type: text/plain

zhangsan
--WebAppBoundary
Content-Disposition: form-data; name="members"
Content-Type: text/plain

lisisi
--WebAppBoundary
Content-Disposition: form-data; name="logo"; filename="windows_logo.png"
Content-Type: image/png

< ../file/windows_logo.png
--WebAppBoundary--

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 注册 Windows', () => {
        checkAPIResult(200, -200006)
    })
%}



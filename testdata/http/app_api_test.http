### 上传新的 Windows 应用图标
run upload_logo.http


### 测试 App -- 更新
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/app/update/{{windowsAppId}}?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "name": "Windows应用新名",
  "logoFileId": "{{windowsNewLogoFileId}}",
  "admins": [
    "zhangsan",
    "wangwu"
  ],
  "members": [
    "zhaoliu",
    "lisisi"
  ]
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 更新', () => {
        checkAPIResult(200, -200004)
    })
%}


### 测试 App -- 获取应用信息
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/app/getInformation/{{windowsAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const info = response.body.data
    client.test('测试响应结果 -- 获取应用信息', () => {
        checkAPIResult(200, undefined)
        client.assert(info, 'info is empty')
    })
%}



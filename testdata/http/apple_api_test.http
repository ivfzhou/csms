### 测试 Apple -- 获取应用证书和描述文件列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/apple/listAppCertificates/{{appleAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    const profileId = list.find(v => {
        return v.category === 2
    }).id
    const signingCertificateId = list.find(v => {
        return v.category === 1
    }).id
    const pushCertificateId = list.find(v => {
        return v.category === 3
    }).id
    client.test('测试响应结果 -- 获取应用证书和描述文件列表', () => {
        checkAPIResult(200, undefined)
        client.assert(profileId, 'profileId is empty')
        client.assert(signingCertificateId, 'signingCertificateId is empty')
        client.assert(pushCertificateId, 'pushCertificateId is empty')
    })
    client.global.set('profileId', profileId)
    client.global.set('pushCertificateId', pushCertificateId)
    client.global.set('signingCertificateId', signingCertificateId)
%}


### 测试 Apple -- 下载证书和描述文件
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    const profileId = client.global.get('profileId')
    const pushCertificateId = client.global.get('pushCertificateId')
    const signingCertificateId = client.global.get('signingCertificateId')
    request.variables.set('clients', [
        {
            'certificateId': profileId,
            'type': 2
        },
        {
            'certificateId': pushCertificateId,
            'type': 3
        },
        {
            'certificateId': signingCertificateId,
            'type': 1
        }
    ])
%}
GET https://127.0.0.1/backend/web/apple/downloadCertificate/{{appleAppId}}?language={{language}}&
    certificateId={{$.clients..certificateId}}&type={{$.clients..type}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 下载证书和描述文件', () => {
        checkAPIResult(200, undefined)
        client.assert(response.body !== undefined, 'body is empty')
    })
%}


### 测试 Apple OpenAPI -- 下载证书和描述文件
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('appleAppId')
    const apiAccountId = 'apple_api_account';
    const secret = client.global.get(apiAccountId)
    client.log(appId, apiAccountId, secret)
    const token = createAuthorization(appId, apiAccountId, secret)
    request.variables.set('token', token)
    const profileId = client.global.get('profileId')
    const pushCertificateId = client.global.get('pushCertificateId')
    const signingCertificateId = client.global.get('signingCertificateId')
    request.variables.set('clients', [
        {
            'certificateId': profileId,
            'type': 2
        },
        {
            'certificateId': pushCertificateId,
            'type': 3
        },
        {
            'certificateId': signingCertificateId,
            'type': 1
        }
    ])
%}
GET https://127.0.0.1/backend/api/apple/downloadCertificate?certificateId={{$.clients..certificateId}}&
    type={{$.clients..type}}
Authorization: Bearer {{token}}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 下载证书和描述文件', () => {
        checkAPIResult(200, undefined)
        client.assert(response.body !== undefined, 'body is empty')
    })
%}



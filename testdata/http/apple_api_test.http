import upload_ipa.http
import approve_device_register.http


### 测试 Apple -- 申请 Bundle ID
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    request.variables.set('clients', [
        {
            'bundleId': 'cn.ivfzhou.test',
            'type': 1
        },
        {
            'bundleId': 'cn.ivfzhou.test.db',
            'type': 2
        }
    ])
%}
POST https://127.0.0.1/backend/web/apple/applyBundleID/{{appleAppId}}?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "bundleId": "{{$.clients..bundleId}}",
  "type": {{$.clients..type}}
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 申请 Bundle ID', () => {
        checkAPIResult(200, -200004)
    })
%}



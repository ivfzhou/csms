### 测试 Apple OpenAPI -- 提交签名任务
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('appleAppId')
    const apiAccountId = 'apple_api_account';
    const secret = client.global.get(apiAccountId)
    client.log(appId, apiAccountId, secret)
    const token = createAuthorization(appId, apiAccountId, secret)
    request.variables.set('token', token)
%}
POST https://127.0.0.1/backend/api/apple/submitSigningJob
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "profileId": "{{profileId}}",
  "fileId": "{{ipaFileId}}"
}

> {%
    import {checkAPIResult} from './http_util.js'

    const jobId = response.body.data.jobId
    client.test('测试响应结果 -- 提交签名任务', () => {
        checkAPIResult(200, undefined)
        client.assert(jobId, 'jobId is empty')
    })
    client.global.set('appleJobId', jobId)
%}


### 测试 Apple OpenAPI -- 获取签名任务信息
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('appleAppId')
    const apiAccountId = 'apple_api_account';
    const secret = client.global.get(apiAccountId)
    client.log(appId, apiAccountId, secret)
    const token = createAuthorization(appId, apiAccountId, secret)
    request.variables.set('token', token)
%}
GET https://127.0.0.1/backend/api/apple/getSigningJobInformation?jobId={{appleJobId}}
Authorization: Bearer {{token}}

> {%
    import {checkAPIResult} from './http_util.js'

    const info = response.body.data
    client.test('测试响应结果 -- 获取签名任务信息', () => {
        checkAPIResult(200, undefined)
        client.assert(info, 'info is empty')
    })
%}

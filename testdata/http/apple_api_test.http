### 测试 Apple -- 获取 Bundle ID 列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/apple/listBundleIDs/{{appleAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    const bundleId = list[1].id
    const inHouseBundleId = list[0].id
    client.test('测试响应结果 -- 获取 Bundle ID 列表', () => {
        checkAPIResult(200, undefined)
        client.assert(bundleId, 'bundleId is empty')
        client.assert(inHouseBundleId, 'inHouseBundleId is empty')
    })
    client.global.set('bundleId', bundleId)
    client.global.set('inHouseBundleId', inHouseBundleId)
%}



### 测试 Todo -- 创建 - 加入应用
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/todo/create?language={{language}}
Content-Type: application/json
Date: {{date}}
Cookie: csms_user=tianqi; csms_session={{csms_session_tianqi}}

{
  "type": 2,
  "appId": "{{windowsAppId}}",
  "applyReason": "申请加入应用"
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 创建 - 加入应用', () => {
        checkAPIResult(200, -200004)
    })
%}


### 获取需要处理的待办
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/todo/list?language={{language}}&pageNumber=1&pageSize=10
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const id = response.body.data.list.pop().id
    checkAPIResult(200, undefined)
    client.assert(id, 'todo id not found')
    client.global.set('todoId', id)
%}


### 测试 Todo -- 获取待办详情
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/todo/getDetail?language={{language}}&id={{todoId}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const info = response.body.data
    client.test('测试响应结果 -- 获取待办详情', () => {
        checkAPIResult(200, undefined)
        client.assert(info, 'info is empty')
    })
%}


### 测试 Todo -- 审批 - 加入应用
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/todo/deal?language={{language}}
Content-Type: application/json
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "id": {{todoId}},
  "isPass": true,
  "approveMessage": "同意"
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 审批 - 加入应用', () => {
        checkAPIResult(200, -200004)
    })
%}



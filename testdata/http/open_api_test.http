### 测试 Open API -- 重置密钥
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/open/reset/{{windowsAppId}}?language={{language}}&accountId={{windowsApiAccountId}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const password = response.body.data.password
    client.test('测试响应结果 -- 重置密钥', () => {
        checkAPIResult(200, undefined)
        client.assert(password, `password is empty`)
    })
    client.global.set('windows_api_account', password)
%}


### 申请请求凭证账号
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/open/apply/{{windowsAppId}}?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "accountId": "windows_api_account_to_be_delete",
  "authorities": [
    1,
    2,
    3,
    4,
    9,
    10,
    11
  ],
  "requestIp": "*",
  "frequency": 500
}

> {%
    import {checkAPIResult} from './http_util.js'

    const password = response.body.data.password
    checkAPIResult(200, undefined)
    client.assert(password, `password is empty`)
%}



### 测试 Windows -- 提交签名任务
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    const exeFileId = client.global.get('exeFileId')
    const cabFileId = client.global.get('cabFileId')
    const sysFileId = client.global.get('sysFileId')
    const uploadWindowsCertificateId = client.global.get('uploadWindowsCertificateId')
    const windowsCompanyOVCertificateId = client.global.get('windowsCompanyOVCertificateId')
    const windowsPersonalEVCertificateId = client.global.get('windowsPersonalEVCertificateId')
    const windowsCompanyEVCertificateId = client.global.get('windowsCompanyEVCertificateId')
    request.variables.set('clients', [
        {
            'signingType': 1,
            'fileId': exeFileId,
            'certificateId': uploadWindowsCertificateId
        },
        {
            'signingType': 1,
            'fileId': exeFileId,
            'certificateId': windowsCompanyOVCertificateId
        },
        {
            'signingType': 1,
            'fileId': exeFileId,
            'certificateId': windowsPersonalEVCertificateId
        },
        {
            'signingType': 1,
            'fileId': exeFileId,
            'certificateId': windowsCompanyEVCertificateId
        },
        {
            'signingType': 2,
            'fileId': cabFileId,
            'certificateId': ''
        },
        {
            'signingType': 2,
            'fileId': sysFileId,
            'certificateId': ''
        },
        {
            'signingType': 3,
            'fileId': sysFileId,
            'certificateId': uploadWindowsCertificateId
        },
        {
            'signingType': 3,
            'fileId': cabFileId,
            'certificateId': windowsCompanyOVCertificateId
        },
        {
            'signingType': 3,
            'fileId': sysFileId,
            'certificateId': windowsPersonalEVCertificateId
        },
        {
            'signingType': 3,
            'fileId': cabFileId,
            'certificateId': windowsCompanyEVCertificateId
        }
    ])
%}
POST https://127.0.0.1/backend/web/windows/submitSigningJob/{{windowsAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

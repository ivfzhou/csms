### 测试 Windows OpenAPI -- 下载证书
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('windowsAppId')
    const apiAccountId = 'windows_api_account';
    const secret = client.global.get(apiAccountId)
    client.log(appId, apiAccountId, secret)
    const token = createAuthorization(appId, apiAccountId, secret)
    request.variables.set('token', token)
%}
GET https://127.0.0.1/backend/api/windows/downloadCertificate?certificateId={{uploadWindowsCertificateId}}
Authorization: Bearer {{token}}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 下载证书', () => {
        checkAPIResult(200, undefined)
        client.assert(response.headers.valueOf('Content-Length'), `http body is empty`)
    })
%}


### 测试 Windows OpenAPI -- 查看证书密码
< {%
    import {createAuthorization} from './http_util.js'

    const appId = client.global.get('windowsAppId')
    const apiAccountId = 'windows_api_account';

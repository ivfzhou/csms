### 测试 Windows -- 提交 WHQL 任务
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
    const sysFileId = client.global.get('sysFileId')
    const zipFileId = client.global.get('zipFileId')
    const hlkxFileId = client.global.get('hlkxFileId')
    request.variables.set('clients', [
        {
            'signingType': 1,
            'fileId': sysFileId,
            'serviceName': '',
            'testTarget': '',
            'testSystem': 'Windows 10 22H2_64'
        },
        {
            'signingType': 1,
            'fileId': zipFileId,
            'serviceName': 'KMDFDriver',
            'testTarget': 'KMDFDriver.sys',
            'testSystem': 'Windows 10 22H2_64'
        },
        {
            'signingType': 2,
            'fileId': hlkxFileId,
            'serviceName': '',
            'testTarget': '',
            'testSystem': ''
        }
    ])
%}

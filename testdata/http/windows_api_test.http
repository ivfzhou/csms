        },
        {
            'signingType': 2,
            'fileId': cabFileId,
            'certificateId': windowsCompanyEVCertificateId
        },
        {
            'signingType': 3,
            'fileId': sysFileId,
            'certificateId': uploadWindowsCertificateId
        },
        {
            'signingType': 3,
            'fileId': cabFileId,
            'certificateId': windowsCompanyOVCertificateId
        },
        {
            'signingType': 3,
            'fileId': sysFileId,
            'certificateId': windowsPersonalEVCertificateId
        },
        {
            'signingType': 3,
            'fileId': cabFileId,
            'certificateId': windowsCompanyEVCertificateId

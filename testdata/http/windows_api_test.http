### 测试 Windows -- 上传个人 OV 证书
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/windows/uploadCertificate/{{windowsAppId}}?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "certificate": "",
  "password": "123456"
}

> {%
    import {checkAPIResult} from './http_util.js'

    client.test('测试响应结果 -- 上传个人 OV 证书', () => {
        checkAPIResult(200, -200004)
    })
%}


### 测试 Windows -- 证书列表
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/windows/listCertificates/{{windowsAppId}}?language={{language}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    const id = response.body.data.list.pop().id
    client.test('测试响应结果 -- 证书列表', () => {
        checkAPIResult(200, undefined)
        client.assert(id, 'certificate id is empty')
    })
    client.global.set('uploadWindowsCertificateId', id)
%}



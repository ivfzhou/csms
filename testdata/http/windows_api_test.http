### 测试 Windows -- 获取后台管理中的 Windows 证书
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/windows/listCompanyCertificates?language={{language}}
Date: {{date}}
Cookie: csms_user=admin; csms_session={{csms_session_admin}}

> {%
    import {checkAPIResult} from './http_util.js'

    const list = response.body.data.list
    const windowsCompanyOVCertificate = list.find(v => {
        return v.type === 2
    })
    const windowsPersonalEVCertificate = list.find(v => {
        return v.type === 3
    })
    const windowsCompanyEVCertificate = list.find(v => {
        return v.type === 1
    })
    client.test('测试响应结果 -- 获取后台管理中的 Windows 证书', () => {
        checkAPIResult(200, undefined)
        client.assert(windowsCompanyOVCertificate, 'certificate is empty')
        client.assert(windowsPersonalEVCertificate, 'certificate is empty')
        client.assert(windowsCompanyEVCertificate, 'certificate is empty')
    })

    client.global.set('windowsCompanyOVCertificateId', windowsCompanyOVCertificate.id)
    client.global.set('windowsPersonalEVCertificateId', windowsPersonalEVCertificate.id)
    client.global.set('windowsCompanyEVCertificateId', windowsCompanyEVCertificate.id)
%}



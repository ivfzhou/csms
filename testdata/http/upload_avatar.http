###
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/file/initial?language={{language}}
Date: {{date}}
Content-Type: application/json
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

{
  "name": "zhangsan_new_avatar.jpg",
  "size": 72262,
  "md5": "d7866f745b232b336aab5c33863c31fa",
  "type": 1
}

> {%
    import {checkAPIResult} from './http_util.js'

    checkAPIResult(200, undefined)
    client.assert(response.body.data.fileId, 'file id not found')
    client.global.set('zhangsanNewAvatarFileId', response.body.data.fileId)
%}


###
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
POST https://127.0.0.1/backend/web/file/uploadPart?language={{language}}
Date: {{date}}
Content-Type: multipart/form-data; boundary=WebAppBoundary
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

--WebAppBoundary
Content-Disposition: form-data; name="fileId"
Content-Type: text/plain

{{zhangsanNewAvatarFileId}}
--WebAppBoundary
Content-Disposition: form-data; name="chunkNumber"
Content-Type: text/plain

1
--WebAppBoundary
Content-Disposition: form-data; name="chunk"; filename="chunk"
Content-Type: application/octet-stream

< ../file/zhangsan_new_avatar.jpg
--WebAppBoundary--

> {%
    import {checkAPIResult} from './http_util.js'

    checkAPIResult(200, undefined)
%}


###
< {%
    import {initWebAPI} from './http_util.js'

    initWebAPI()
%}
GET https://127.0.0.1/backend/web/file/mergeParts?language={{language}}&fileId={{zhangsanNewAvatarFileId}}
Date: {{date}}
Cookie: csms_user=zhangsan; csms_session={{csms_session_zhangsan}}

> {%
    import {checkAPIResult} from './http_util.js'

    checkAPIResult(200, -200007)
%}
